{
  "name": "hipercare-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && eleventy",
    "dev": "eleventy --serve",
    "check": "node --check script.js && node scripts/check-site.js",
    "test": "npm run build && npm run check",
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "parse5": "8.0.0"
  }
}
