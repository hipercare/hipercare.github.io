<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Hipercare</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#2458e6">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Hipercare">
  <meta property="og:title" content="{{ title }} · Hipercare">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/images/logo/social-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Hipercare. Better care. Within reach.">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="apple-touch-icon" href="/images/logo/apple-touch-icon.png">
  <link rel="preload" href="/assets/manrope-400.woff" as="font" type="font/woff" crossorigin>
  <link rel="preload" href="/assets/manrope-600.woff" as="font" type="font/woff" crossorigin>
  <link rel="stylesheet" href="/styles.css">
</head>
